#!/bin/bash
# Local lifecycle suite for the route-store commands (M2a, TEL-015 "`up` twice
# preserves state"). Exercises the REAL scripts/route-store/{provision,start}: the
# real lock wrapper inside the runner container, the real Telelem.Ops.FileStore, on
# disposable host directories.
#
#   integration/m2a/route-store/run                     # exit 0 PASS · 1 FAIL · 2 prerequisite missing
#   integration/m2a/route-store/run --cleanup-selftest  # only case 0 (stubbed docker; no daemon needed)
#
# Every store is a fresh `mktemp -d` directory (mode 700) that is removed on exit.
# Readiness and acknowledgements are JSON lines read from the writer's stdout through
# FIFOs. Every wait is a bounded `read -t`, and a timeout counts as FAIL. No step relies
# on a sleep for ordering.
#
# Host processes: the docker clients and the case-3 holder each run under `supervise`
# (next to this script), a Python supervisor owned by the suite. The supervisor spawns
# the child itself and opens a pidfd on it before the child can be reaped. The
# supervisor is the only process that can reap it, and it reaps only after the pidfd
# reports the exit. The suite asks for TERM or KILL over the supervisor's control FIFO.
# The supervisor signals only through that pidfd, and it reports each send and the
# exit code on a status FIFO. Neither this script nor the supervisor ever signals by a
# PID. Closing the control FIFO (which also happens if this shell dies) makes the
# supervisor SIGKILL its child. No host signal ever goes to a BEAM. A BEAM is stopped
# or killed only through docker, by the full container ID, after verify_writer tied
# that ID to this run, role, store, BEAM PID and store lock. A failed check aborts the
# run before the action.
#
# Cleanup removes a container only by full ID and only after owned_cid accepted it. It
# must be a name this run registered, with exactly one container under it, the
# inspected Id and Name, the registered role label, and exactly one bind mount at
# /sbx/store whose source is the store registered for that name (inside this run's
# mktemp dir). Once an ID is accepted for a name it is pinned: later lookups of that
# name, cleanup's included, must give the same ID. A container counts as gone only if
# a `docker ps` exited 0 with empty output. A failed lookup, inspect or rm is never
# taken as gone. It is reported with docker's stderr and fails the run. Anything else
# is left alone, reported, and fails the run. Case 0 tests those paths against a
# stubbed docker that only records rm calls, and tests the supervisor on its own
# children.
# Nothing here uses a network (all containers run --network none), touches host
# settings or writes outside the temp directory.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/../../.." && pwd)"
RS="$ROOT/scripts/route-store"
WRAP="$ROOT/scripts/with-route-store-lock"
IMAGE="${TELELEM_IMAGE:-telelem-mix:elixir-1.20.5-otp-28.5.0.8-hex-2.7.0}"
T=60 # bound (s) for one readiness/ack/exit wait; generous for a cold container boot

SELFTEST_ONLY=0
case ${1-} in
  '') ;;
  --cleanup-selftest) SELFTEST_ONLY=1 ;;
  *) echo "usage: $0 [--cleanup-selftest]" >&2; exit 2 ;;
esac
prereq() { echo "prerequisite missing: $*" >&2; exit 2; }
[[ $(uname -s) == Linux ]] || prereq "Linux"
[[ -r /proc/self/fdinfo/0 ]] || prereq "/proc"
command -v python3 >/dev/null 2>&1 || prereq "python3 (JSON parsing, process supervisor)"
python3 -I -c 'import os, signal; os.pidfd_open(os.getpid()); signal.pidfd_send_signal; os.waitstatus_to_exitcode' 2>/dev/null ||
  prereq "python3 >= 3.9 with os.pidfd_open (kernel >= 5.3)"
[[ -r $HERE/supervise ]] || prereq "$HERE/supervise"
if ((!SELFTEST_ONLY)); then
  for x in "$RS/provision" "$RS/start" "$RS/launch" "$WRAP"; do [[ -x $x ]] || prereq "executable $x"; done
  command -v docker >/dev/null 2>&1 || prereq "docker CLI"
  docker info >/dev/null 2>&1 || prereq "a reachable docker daemon for the invoking user"
  docker image inspect "$IMAGE" >/dev/null 2>&1 || prereq "runner image $IMAGE (scripts/setup)"
fi

BASE=$(mktemp -d "${TMPDIR:-/tmp}/telelem-route-store.XXXXXX") || exit 2
BASE=$(realpath -e "$BASE")
chmod 700 "$BASE"
case $(LC_ALL=C stat -f -c %T "$BASE") in
  ext2/ext3 | xfs | btrfs | zfs | tmpfs) ;;
  *) echo "temp dir $BASE is on an unsupported filesystem; set TMPDIR" >&2; rm -rf "$BASE"; exit 2 ;;
esac
NONCE=$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')
PREFIX="telelem-rs-test-$NONCE"

# --- supervised host processes ------------------------------------------------------------
# The BEAM's kernel start time, read only (verify_writer, still_same). Never used to
# pick a signal target.
proc_start() {
  local st f
  { st=$(<"/proc/$1/stat"); } 2>/dev/null || return 1
  st=${st##*) }
  read -ra f <<<"$st"
  [[ ${f[19]-} =~ ^[0-9]+$ ]] && printf '%s' "${f[19]}"
}
# Each supervised child has a KEY. SCTL[KEY] is this shell's fd on the supervisor's
# control FIFO (unset once released). SST[KEY] is the fd on its status FIFO (unset
# once the exit is read). SEXIT[KEY] is the reported exit code.
declare -A SCTL=() SST=() SEXIT=()
# spawn KEY [KEEP_FD ...] -- CMD ...: start CMD under a new `supervise`. Redirections on
# the `spawn` call become CMD's stdio, and KEEP_FDs are passed through as well. Waits
# (bounded) for "started". On failure sets WHY and returns 1.
spawn() {
  local key=$1 d c s
  shift
  [[ -z ${SST[$key]-} && -z ${SEXIT[$key]-} ]] || { WHY="supervisor key '$key' reused"; return 1; }
  d="$BASE/sup-$key"
  mkdir "$d" && mkfifo "$d/ctl" "$d/st" || { WHY="cannot create $d"; return 1; }
  exec {c}<>"$d/ctl" {s}<>"$d/st"
  SCTL[$key]=$c SST[$key]=$s
  # `<&0`: an async command with no stdin redirection of its own gets /dev/null.
  python3 -I "$HERE/supervise" "$d/ctl" "$d/st" "$@" <&0 {c}>&- {s}>&- &
  # $! is not kept: the supervisor is never signalled, waited on or identified by PID.
  sup_line "$key" || { WHY="supervisor for '$key' did not start within ${T}s"; sup_end "$key"; return 1; }
  [[ $SLINE == started\ * ]] || { WHY="supervisor for '$key' answered '$SLINE', not started"; sup_end "$key"; return 1; }
}
# sup_line KEY: next status line of KEY -> SLINE (bounded). Records "exit RC" in SEXIT.
sup_line() {
  SLINE=
  read -r -t "$T" -u "${SST[$1]}" SLINE || { check_sig; SLINE="<timeout>"; return 1; }
  check_sig
  [[ $SLINE =~ ^exit\ ([0-9]+)$ ]] && SEXIT[$1]=${BASH_REMATCH[1]}
  return 0
}
# sup_sig KEY TERM|KILL: ask KEY's supervisor to signal its child through the pidfd.
# Returns 0 only on "sent SIG". Otherwise sets WHY and returns 1, and nothing was sent,
# or the child had already exited.
sup_sig() {
  [[ $2 == TERM || $2 == KILL ]] || { WHY="SIG$2 is not a signal this suite sends"; return 1; }
  [[ -n ${SCTL[$1]-} && -z ${SEXIT[$1]-} ]] || { WHY="'$1' is not a running supervised child"; return 1; }
  printf '%s\n' "$2" >&"${SCTL[$1]}"
  while sup_line "$1"; do
    [[ $SLINE == "sent $2" ]] && return 0
    [[ -n ${SEXIT[$1]-} ]] && { WHY="'$1' exited (${SEXIT[$1]}) before SIG$2 was sent"; return 1; }
    WHY="supervisor for '$1' answered '$SLINE' to $2"
    return 1
  done
  WHY="supervisor for '$1' did not answer $2 within ${T}s"
  return 1
}
# sup_release KEY: close the control FIFO. The supervisor then SIGKILLs a still-running
# child (through its pidfd) and reports the exit.
sup_release() {
  local c=${SCTL[$1]-}
  [[ -n $c ]] || return 0
  exec {c}>&-
  unset 'SCTL[$1]'
}
# sup_end KEY: release KEY, read up to its "exit" line (bounded), and close its status
# FIFO. Returns 1, keeping the status FIFO for cleanup to retry, if no exit was reported.
sup_end() {
  local s=${SST[$1]-}
  sup_release "$1"
  [[ -n $s ]] || return 0
  until [[ -n ${SEXIT[$1]-} ]]; do sup_line "$1" || return 1; done
  exec {s}<&-
  unset 'SST[$1]'
}
# sup_wait KEY: wait (bounded) for KEY's child to exit -> WAIT_RC. If the bound hits:
# release it (SIGKILL through the pidfd), WAIT_RC=124, return 1.
sup_wait() {
  until [[ -n ${SEXIT[$1]-} ]]; do sup_line "$1" || break; done
  if [[ -n ${SEXIT[$1]-} ]]; then
    WAIT_RC=${SEXIT[$1]}
    sup_end "$1"
    return 0
  fi
  WAIT_RC=124
  sup_end "$1" || echo "supervisor for '$1' reported no exit after its release" >&2
  return 1
}

# --- container ownership and cleanup -------------------------------------------------------
NAMES=()             # container names this run passed to the launcher (or to docker run)
declare -A ROLE=()   # name -> telelem.route-store label value it was created with
declare -A MOUNT=()  # name -> host store this run bind-mounted at /sbx/store for it
declare -A CIDOF=()  # name -> full ID pinned at the first accepted check
REJECTED=0           # container lookups cleanup could not resolve to "removed" or "gone"
HEX64='^[0-9a-f]{64}$'
OWNER_PY='import json, sys
cid, name, role, store = sys.argv[1:5]
def no(why):
    print(why)
    sys.exit(1)
try:
    d = json.load(sys.stdin)
except ValueError:
    no("inspect output is not JSON")
if not (isinstance(d, list) and len(d) == 1 and isinstance(d[0], dict)):
    no("inspect did not return exactly one container")
c = d[0]
if c.get("Id") != cid:
    no("inspect Id is %r" % c.get("Id"))
if c.get("Name") != "/" + name:
    no("inspect Name is %r, not %r" % (c.get("Name"), "/" + name))
labels = (c.get("Config") or {}).get("Labels") or {}
if labels.get("telelem.route-store") != role:
    no("label telelem.route-store is %r, not %r" % (labels.get("telelem.route-store"), role))
ms = [m for m in (c.get("Mounts") or []) if isinstance(m, dict) and m.get("Destination") == "/sbx/store"]
if len(ms) != 1:
    no("%d mounts at /sbx/store, want exactly 1" % len(ms))
if ms[0].get("Type") != "bind" or ms[0].get("Source") != store:
    no("/sbx/store is %s %r, not a bind of %r" % (ms[0].get("Type"), ms[0].get("Source"), store))'
# dk ARGS...: run docker. stdout -> DOUT, stderr (one line) -> DERR, returns its status.
dk() {
  local rc
  DOUT=$(docker "$@" 2>"$BASE/dk-err")
  rc=$?
  DERR=$(tr '\n' ' ' <"$BASE/dk-err" 2>/dev/null)
  DERR=${DERR% }
  return "$rc"
}
# ps_ids FILTER -> IDS: full IDs of every container (running or not) matching FILTER.
# Returns 1 and sets WHY, including docker's status and stderr, if `docker ps` failed.
# Only a 0 return with empty IDS means "no such container".
ps_ids() {
  local rc
  IDS=
  dk ps -a --no-trunc --filter "$1" --format '{{.ID}}'
  rc=$?
  ((rc == 0)) || { WHY="docker ps --filter $1 failed (exit $rc): ${DERR:-no stderr}"; return 1; }
  IDS=$DOUT
}
# gone_by_id ID: 0 only if `docker ps` exited 0 and listed nothing for this full ID.
# Otherwise sets WHY and returns 1.
gone_by_id() {
  ps_ids "id=$1" || return 1
  [[ -z $IDS ]] || { WHY="$1 is still listed"; return 1; }
}
# owned_cid NAME -> CID: the full (64-hex, immutable) ID of this run's container NAME.
# Accepted only if NAME was registered with a role and a store inside this run's mktemp
# dir, exactly one container has that exact name, its ID equals the one pinned for NAME
# (if any), and `docker inspect ID` shows that Id and Name, the registered role label and
# exactly one bind mount at /sbx/store from the registered store. The first accepted ID
# is pinned in CIDOF. Otherwise sets WHY and returns 1. GONE=1 only if a `docker ps`
# exited 0 and listed nothing: for the name, or for the listed ID after a failed
# inspect. A failed lookup is never "gone". Docker addresses a full ID to exactly one
# container, never to a later one, so every action below uses only CID. Never call it
# in $(...): CIDOF must persist.
owned_cid() {
  local name=$1 ids js why ierr
  CID= WHY= GONE=0
  [[ -n ${ROLE[$name]-} ]] || { WHY="name '$name' was not registered by this run"; return 1; }
  [[ ${MOUNT[$name]-} == "$BASE"/?* ]] || { WHY="'$name' store '${MOUNT[$name]-}' is not inside $BASE"; return 1; }
  ps_ids "name=^${name}\$" || return 1
  ids=$IDS
  [[ -n $ids ]] || { GONE=1; WHY="no container named '$name'"; return 1; }
  [[ $ids =~ $HEX64 ]] || { WHY="want one full container ID for '$name', got '${ids//$'\n'/,}'"; return 1; }
  [[ -z ${CIDOF[$name]-} || ${CIDOF[$name]} == "$ids" ]] ||
    { WHY="'$name' now resolves to $ids, not the pinned ${CIDOF[$name]}"; return 1; }
  if ! dk inspect --type container "$ids"; then
    ierr=${DERR:-no stderr}
    # Removed (--rm) between ps and inspect is gone, but only if a lookup by ID says so.
    if gone_by_id "$ids"; then GONE=1 WHY="$ids removed before inspect"; else WHY="docker inspect $ids failed ($ierr); $WHY"; fi
    return 1
  fi
  js=$DOUT
  why=$(python3 -I -c "$OWNER_PY" "$ids" "$name" "${ROLE[$name]}" "${MOUNT[$name]}" <<<"$js") ||
    { WHY="$ids: ${why:-ownership check failed}"; return 1; }
  CID=$ids
  CIDOF[$name]=$ids
}
# rm_owned NAME: force-remove this run's container by full ID; else leave it alone. Every
# outcome other than "removed" or "gone" (per gone_by_id) is reported and counted.
rm_owned() {
  local rerr
  if owned_cid "$1"; then
    dk rm -f "$CID" && return 0
    rerr=${DERR:-no stderr}
    gone_by_id "$CID" && return 0 # removed by --rm or another pass in between
    echo "cleanup: could not remove '$1' ($CID): docker rm failed ($rerr); $WHY" >&2
    REJECTED=$((REJECTED + 1))
  elif ((!GONE)); then
    echo "cleanup: left '$1' alone: $WHY" >&2
    REJECTED=$((REJECTED + 1))
  fi
}
reap_containers() { # every registered name, twice: a create already in flight at the
  local n          # daemon can land after the first pass. Narrowed, not closed (README).
  for n in "${NAMES[@]}"; do rm_owned "$n"; done
  for n in "${NAMES[@]}"; do rm_owned "$n"; done
}
cleanup() {
  local rc=$? k
  trap - EXIT INT TERM HUP
  SIG=0 # the signal (if any) is in rc already; let the bounded reads below run
  # Clients first, so none of them goes on to create or start a container. Releasing
  # every supervisor makes each SIGKILL its child through its pidfd.
  for k in "${!SCTL[@]}"; do sup_release "$k"; done
  for k in "${!SST[@]}"; do
    sup_end "$k" || { echo "cleanup: supervisor for '$k' reported no exit; its child may still run" >&2; ((rc)) || rc=1; }
  done
  reap_containers
  rm -rf -- "$BASE"
  if ((REJECTED)); then
    echo "cleanup could not confirm removal of $REJECTED container lookup(s): ownership not shown, or docker failed" >&2
    ((rc)) || rc=1
  fi
  exit "$rc"
}
trap cleanup EXIT
# Signal traps only record the signal. The run exits at its next checkpoint (every
# bounded read, every check), never from inside the trap:
# bash 5.3 was seen to segfault when a trap's `exit` ran during a $(...) expansion
# and the EXIT trap then ran more command substitutions, skipping cleanup.
SIG=0
trap 'SIG=129' HUP
trap 'SIG=130' INT
trap 'SIG=143' TERM
check_sig() { ((SIG == 0)) || { echo "interrupted (signal exit $SIG); cleaning up" >&2; exit "$SIG"; }; }

PASS=0 FAIL=0
ok() { printf 'ok   %s\n' "$*"; PASS=$((PASS + 1)); }
bad() { printf 'FAIL %s\n' "$*"; FAIL=$((FAIL + 1)); }
expect() { check_sig; if [[ $2 == "$3" ]]; then ok "$1"; else bad "$1 (got '$2', want '$3')"; fi; }

# --- helpers ------------------------------------------------------------------------------
N=0
new_store() { # -> STORE: fresh, empty, mode 700
  N=$((N + 1))
  STORE="$BASE/s$N"
  mkdir -m 700 "$STORE"
}
# cname SUFFIX ROLE STORE -> CNAME: register a container name with the label value and
# the store it will be created with. Never in $(...): the registrations must persist.
cname() {
  CNAME="$PREFIX-$1"
  NAMES+=("$CNAME")
  ROLE[$CNAME]=$2
  MOUNT[$CNAME]=$3
}
# Store tree: names, inodes, sizes, mtimes, modes and content hashes.
snapshot() {
  (cd "$1" && find . -mindepth 1 -printf '%P|%i|%s|%T@|%m|' -exec sh -c 'sha256sum <"$1" 2>/dev/null | cut -c1-64 || echo dir' _ {} \; | sort)
}
jget() { # json-line python-expression-on-d  (e.g. 'd["record"]["rev"]')
  python3 -I -c 'import json,sys
d = json.loads(sys.argv[1])
v = eval(sys.argv[2], {"d": d})
print("null" if v is None else v)' "$1" "$2" 2>/dev/null || echo "<unparsable>"
}
PROV_ARGS=(--tenant local --route chat --deployments a,b --preferred a
  --fallback-on-refusal true --deadline-ms 5000 --max-attempts 2)

# run_cmd NAME provision|start STORE ARGS... : foreground, synchronous, bounded. Sets RC,
# OUT (stdout) and ERR (stderr). A run that exceeds the bound is a FAIL. Its client is
# then SIGKILLed through its supervisor and its container is removed (owned_cid, full
# ID).
run_cmd() {
  local n mode=$2 store=$3
  cname "$1" "$mode" "$store"
  n=$CNAME
  shift 3
  spawn "$n" -- "$RS/$mode" --container-name "$n" --store "$store" "$@" >"$BASE/out" 2>"$BASE/err" </dev/null ||
    abort "$mode ($n) not started: $WHY"
  if ! sup_wait "$n"; then
    bad "$mode ($n) did not exit within ${T}s"
    rm_owned "$n"
  fi
  RC=$WAIT_RC
  OUT=$(<"$BASE/out") ERR=$(<"$BASE/err")
}
# client_sig SIG: through its supervisor, signal the current writer's docker client
# (never the BEAM), or abort.
client_sig() {
  sup_sig "$WNAME" "$1" || abort "SIG$1 to the writer client of $WNAME not sent: $WHY"
}

# Long-running writer. start_writer NAME STORE [plain]: starts the docker client under a
# supervisor keyed by WNAME and sets WIN/WOUT (fds for the writer's stdin/stdout).
# Default: under harness control (stdin attached). `plain`: the product form, no stdin
# attached, stopped only by SIGTERM.
start_writer() {
  cname "$1" start "$2"
  WNAME=$CNAME
  local d="$BASE/w-$1" ctl=(--harness-control)
  [[ ${3-} == plain ]] && ctl=()
  mkdir "$d"
  mkfifo "$d/in" "$d/out"
  exec {WIN}<>"$d/in" {WOUT}<>"$d/out"
  spawn "$WNAME" -- "$RS/start" --container-name "$WNAME" --store "$2" --tenant local --route chat \
    "${ctl[@]}" <&"$WIN" >&"$WOUT" 2>"$d/err" || abort "writer $WNAME not started: $WHY"
  WERR="$d/err"
}
writer_wait() { sup_wait "$WNAME"; } # -> WAIT_RC (124 and the client SIGKILLed on timeout)
end_writer() { exec {WIN}>&- {WOUT}>&-; }
event() { # wait (bounded) for the next stdout line of the writer -> LINE
  LINE=
  read -r -t "$T" -u "$WOUT" LINE || { check_sig; LINE="<timeout>"; return 1; }
  check_sig
}
send() { printf '%s\n' "$1" >&"$WIN"; }

# Kernel view of the running writer: the container's PID 1 on the host (by full ID).
beam_pid() { docker inspect -f '{{.State.Pid}}' "$1" 2>/dev/null; }
store_key() { # /proc/locks style key for the store inode: MAJ:MIN:INO
  local ma mi ino
  read -r ma mi ino < <(LC_ALL=C stat -c '%Hd %Ld %i' -- "$1")
  printf '%02x:%02x:%d' "$ma" "$mi" "$ino"
}
fd_on_store() { # pid store -> fd numbers of pid whose target is the store inode
  local f want
  want=$(LC_ALL=C stat -c '%d %i' -- "$2")
  for f in /proc/"$1"/fd/*; do
    [[ $(LC_ALL=C stat -L -c '%d %i' -- "$f" 2>/dev/null) == "$want" ]] && printf '%s ' "${f##*/}"
  done
}
holders_of() { # store -> PIDs (any process visible to us) with an fd on the store inode
  # GNU find keeps its own fd on the -samefile reference; learn find's PID (sh prints
  # $$, then execs find with that PID) and drop exactly that one.
  local out self
  out=$(sh -c 'echo "$$"; exec find -L /proc/[0-9]*/fd -maxdepth 1 -samefile "$1"' _ "$1" 2>/dev/null)
  self=${out%%$'\n'*}
  tail -n +2 <<<"$out" | sed -E 's#^/proc/([0-9]+)/fd/.*#\1#' | grep -vx -- "$self" |
    sort -un | tr '\n' ' ' | sed 's/ $//'
}

# verify_writer NAME STORE ROLE: before any action on a running writer, tie this run's
# container to its BEAM. Sets CID (full container ID), VPID (BEAM host PID, read only,
# never signalled) and VSTART (its kernel start time), or WHY and returns 1. Checks:
#   - CID: owned_cid (registered exact name, role and store, pinned full ID, inspected
#     Id/Name/label and the single /sbx/store bind), registered as ROLE on STORE;
#   - docker inspect CID: same Id and name, that label, running, State.Pid > 0, and
#     STORE (inside this run's mktemp dir) bind-mounted at /sbx/store;
#   - kernel, for State.Pid: exe beam.smp; PID 1 of its own PID namespace (NSpid);
#     cgroup path contains CID; exactly one fd on the STORE inode carrying an exclusive
#     FLOCK on it (fdinfo); no other visible process holds STORE; start time unchanged
#     across all of the above.
verify_writer() {
  local name=$1 store=$2 role=$3 got id nm lb run pid src st exe ns fds
  VPID= VSTART=
  owned_cid "$name" || return 1
  [[ ${ROLE[$name]} == "$role" && ${MOUNT[$name]} == "$store" ]] ||
    { WHY="'$name' was registered as ${ROLE[$name]} on ${MOUNT[$name]}, not $role on $store"; return 1; }
  got=$(docker inspect -f '{{.Id}}|{{.Name}}|{{index .Config.Labels "telelem.route-store"}}|{{.State.Running}}|{{.State.Pid}}|{{range .Mounts}}{{if eq .Destination "/sbx/store"}}{{.Source}};{{end}}{{end}}' "$CID" 2>/dev/null) ||
    { WHY="docker inspect $CID failed"; return 1; }
  IFS='|' read -r id nm lb run pid src <<<"$got"
  [[ $id == "$CID" && $nm == "/$name" && $lb == "$role" && $run == true ]] ||
    { WHY="inspect $CID: id/name/label/running = $id $nm $lb $run"; return 1; }
  [[ $src == "$store;" && $store == "$BASE"/* ]] || { WHY="$CID mounts '$src' at /sbx/store, not $store"; return 1; }
  [[ $pid =~ ^[1-9][0-9]*$ ]] || { WHY="$CID State.Pid '$pid'"; return 1; }
  st=$(proc_start "$pid") || { WHY="pid $pid of $CID is gone"; return 1; }
  exe=$(readlink "/proc/$pid/exe" 2>/dev/null)
  [[ ${exe##*/} == beam.smp ]] || { WHY="pid $pid of $CID runs '$exe', not beam.smp"; return 1; }
  ns=$(sed -n 's/^NSpid:[[:space:]]*//p' "/proc/$pid/status" 2>/dev/null)
  [[ ${ns##*[[:space:]]} == 1 && ${ns%%[[:space:]]*} == "$pid" ]] || { WHY="pid $pid NSpid '$ns' (want $pid ... 1)"; return 1; }
  grep -qF -- "$CID" "/proc/$pid/cgroup" 2>/dev/null || { WHY="pid $pid is not in a cgroup of $CID"; return 1; }
  fds=$(fd_on_store "$pid" "$store")
  [[ $fds =~ ^[0-9]+\ $ ]] || { WHY="pid $pid has fds '$fds' on $store (want exactly one)"; return 1; }
  grep -qE "^lock:.*FLOCK +ADVISORY +WRITE .* $(store_key "$store") " "/proc/$pid/fdinfo/${fds% }" 2>/dev/null ||
    { WHY="pid $pid fd ${fds% } carries no exclusive flock on $store"; return 1; }
  [[ $(holders_of "$store") == "$pid" ]] || { WHY="$store is held by '$(holders_of "$store")', not only $pid"; return 1; }
  [[ $(proc_start "$pid") == "$st" ]] || { WHY="pid $pid changed during verification"; return 1; }
  VPID=$pid VSTART=$st
}
# still_same: right before a docker action on CID, the container still runs the BEAM
# verify_writer saw (same State.Pid, same kernel start time). Sets WHY on failure.
still_same() {
  local got
  got=$(docker inspect -f '{{.Id}}|{{.State.Running}}|{{.State.Pid}}' "$CID" 2>/dev/null)
  [[ $got == "$CID|true|$VPID" && $(proc_start "$VPID") == "$VSTART" ]] ||
    { WHY="$CID now '$got', pid $VPID start '$(proc_start "$VPID")' (was $VSTART)"; return 1; }
}
# abort REASON: a check before a signal or docker action failed. Count it, take no
# action, and stop the run (cleanup then removes only containers owned_cid accepts).
abort() { bad "$1"; echo "aborting before the action; passed $PASS, failed $FAIL"; exit 1; }

# --- case 0: cleanup ownership and supervisor self-test --------------------------------------
# Runs the real owned_cid / rm_owned / reap_containers in a subshell where `docker` is a
# shell function. It answers from fixed tables, can be told to fail a lookup or an rm,
# and only RECORDS `rm`. Then runs the real spawn / sup_sig / sup_wait / sup_end and
# `supervise` on this subshell's own short-lived children (sh, true, sleep, cat), and
# the supervisor's writer check against FIFOs this subshell owns. No daemon or
# container is involved. The only signals sent are TERM and KILL from a supervisor,
# through its pidfd, to the child it spawned itself. Prints ok/FAIL lines and returns
# the number of failed checks (capped at 100).
cleanup_selftest() (
  trap - EXIT INT TERM HUP
  local log="$BASE/selftest-rm" gonef="$BASE/selftest-gone" err="$BASE/selftest-err" S="$BASE/selftest-store" fails=0 n i kf
  : >"$log"
  : >"$gonef"
  NAMES=() ROLE=() MOUNT=() CIDOF=() REJECTED=0
  declare -A PS=() INSPECT=() LIVE=() PSFAIL=() IDFAIL=() RMFAIL=() RMVANISH=()
  ck() { if [[ $2 == "$3" ]]; then printf 'ok   %s\n' "$1"; else printf 'FAIL %s (got %s, want %s)\n' "$1" "'$2'" "'$3'"; fails=$((fails + 1)); fi; }
  removed() { grep -qx -- "$1" "$gonef"; }
  # Stub. ps: by exact-name filter (PS table) or by id filter (LIVE table); PSFAIL or
  # IDFAIL make it fail with empty stdout. inspect: by ID (INSPECT table). rm: recorded
  # in $log, then removes (gone file), or fails (RMFAIL), or fails although the
  # container went away meanwhile (RMVANISH, like a --rm race).
  docker() {
    local a n= id=
    case ${1-} in
      ps)
        for a; do
          [[ $a == name=* ]] && { n=${a#name=^}; n=${n%\$}; }
          [[ $a == id=* ]] && id=${a#id=}
        done
        if [[ -n $n ]]; then
          [[ -z ${PSFAIL[$n]-} ]] || { echo "Cannot connect to the Docker daemon (stub)" >&2; return 1; }
          for a in ${PS[$n]-}; do removed "$a" || printf '%s\n' "$a"; done
        elif [[ -n $id ]]; then
          [[ -z ${IDFAIL[$id]-} ]] || { echo "error during connect (stub)" >&2; return 1; }
          [[ -n ${LIVE[$id]-} ]] && ! removed "$id" && printf '%s\n' "$id"
        fi
        return 0 ;;
      inspect)
        a=${!#}
        [[ -n ${INSPECT[$a]-} ]] && ! removed "$a" || { echo "Error: No such container: $a (stub)" >&2; return 1; }
        printf '%s\n' "${INSPECT[$a]}" ;;
      rm)
        a=${!#}
        printf '%s\n' "$a" >>"$log"
        if [[ -n ${RMFAIL[$a]-} ]]; then echo "Error response from daemon: removal refused (stub)" >&2; return 1; fi
        printf '%s\n' "$a" >>"$gonef"
        if [[ -n ${RMVANISH[$a]-} ]]; then echo "Error response from daemon: No such container: $a (stub)" >&2; return 1; fi
        return 0 ;;
      *) echo "stub: unexpected docker $*" >&2; return 1 ;;
    esac
  }
  js() { # ID NAME LABEL(- = no labels) TYPE DEST SOURCE
    local lb="{\"telelem.route-store\":\"$3\"}"
    [[ $3 == - ]] && lb=null
    printf '[{"Id":"%s","Name":"/%s","Config":{"Labels":%s},"Mounts":[{"Type":"%s","Destination":"%s","Source":"%s"}]}]' \
      "$1" "$2" "$lb" "$4" "$5" "$6"
  }
  # scen KEY STORE PS-IDS INSPECT-ID NAME LABEL TYPE DEST SOURCE: register KEY as a start
  # container on STORE, docker ps for it lists PS-IDS, inspect of PS-IDS[0] answers with
  # the given fields (INSPECT-ID is the Id inside that answer), and a lookup by that ID
  # lists it. An empty INSPECT-ID: inspect of PS-IDS[0] fails and a lookup by ID lists
  # nothing.
  scen() {
    cname "st-$1" start "$2"
    PS[$CNAME]=$3
    [[ -n $3 && -n $4 ]] || return 0
    INSPECT[${3%% *}]=$(js "$4" "$5" "$6" "$7" "$8" "$9")
    LIVE[${3%% *}]=1
  }
  for i in {1..21}; do printf -v "h$i" '%064x' "$i"; done
  P="$PREFIX-st"
  scen ok "$S" "$h1" "$h1" "$P-ok" start bind /sbx/store "$S"
  scen mount "$S" "$h2" "$h2" "$P-mount" start bind /sbx/store /srv/foreign
  scen dest "$S" "$h3" "$h3" "$P-dest" start bind /data "$S"
  scen type "$S" "$h4" "$h4" "$P-type" start volume /sbx/store "$S"
  scen role "$S" "$h5" "$h5" "$P-role" provision bind /sbx/store "$S"
  scen nolabel "$S" "$h6" "$h6" "$P-nolabel" - bind /sbx/store "$S"
  scen name "$S" "$h7" "$h7" "$P-name-x" start bind /sbx/store "$S"
  scen idmix "$S" "$h8" "$h9" "$P-idmix" start bind /sbx/store "$S"
  scen two "$S" "$h10 $h11" "$h10" "$P-two" start bind /sbx/store "$S"
  INSPECT[$h11]=$(js "$h11" "$P-two" start bind /sbx/store "$S")
  scen short "$S" "${h12:0:12}" "$h12" "$P-short" start bind /sbx/store "$S"
  scen outside /srv/x "$h13" "$h13" "$P-outside" start bind /sbx/store /srv/x
  scen pinned-swap "$S" "$h14" "$h14" "$P-pinned-swap" start bind /sbx/store "$S"
  CIDOF[$CNAME]=$h1 # verified earlier as a different (now gone) container
  scen pinned "$S" "$h15" "$h15" "$P-pinned" start bind /sbx/store "$S"
  CIDOF[$CNAME]=$h15
  scen gone "$S" "" "" "" "" "" "" ""
  # Failed lookups are never "gone": ps by name fails with empty output; inspect fails and
  # ps by ID fails with empty output; inspect fails while ps by ID still lists it.
  scen psfail "$S" "$h21" "$h21" "$P-psfail" start bind /sbx/store "$S"
  PSFAIL[$CNAME]=1
  scen inspectfail "$S" "$h17" "" "" "" "" "" ""
  IDFAIL[$h17]=1
  scen inspectlisted "$S" "$h18" "" "" "" "" "" ""
  LIVE[$h18]=1
  # Control: inspect fails and ps by ID exits 0 with nothing: removed in between, gone.
  scen inspectrace "$S" "$h16" "" "" "" "" "" ""
  # rm fails and ps by ID still lists the container: reported. rm fails because the
  # container went away meanwhile (ps by ID exits 0 with nothing): gone.
  scen rmfail "$S" "$h19" "$h19" "$P-rmfail" start bind /sbx/store "$S"
  RMFAIL[$h19]=1
  scen rmgone "$S" "$h20" "$h20" "$P-rmgone" start bind /sbx/store "$S"
  RMVANISH[$h20]=1
  PS[$P-unregistered]=$h2 # a perfect-looking container whose name this run never registered

  reap_containers 2>"$err"
  rm_owned "$P-unregistered" 2>>"$err"
  ck "cleanup: docker rm called only for accepted IDs (ok, pinned, rmgone once; rmfail in both passes)" \
    "$(sort "$log" | tr '\n' ' ')" "$(printf '%s\n' "$h1" "$h15" "$h19" "$h19" "$h20" | sort | tr '\n' ' ')"
  for n in mount dest type role nolabel name idmix two short outside pinned-swap psfail inspectfail inspectlisted unregistered; do
    ck "cleanup: '$n' left alone and reported" "$(grep -c "^cleanup: left '$P-$n' alone: " "$err")" \
      "$([[ $n == unregistered ]] && echo 1 || echo 2)"
  done
  ck "cleanup: a failed ps by name (empty output) is reported with docker's stderr, not taken as gone" \
    "$(grep -c "^cleanup: left '$P-psfail' alone: docker ps --filter name=.* failed (exit 1): Cannot connect to the Docker daemon (stub)$" "$err")" 2
  ck "cleanup: a failed inspect plus a failed ps by ID (empty output) is reported with both errors" \
    "$(grep -c "^cleanup: left '$P-inspectfail' alone: docker inspect $h17 failed (Error: No such container: $h17 (stub)); docker ps --filter id=$h17 failed (exit 1): error during connect (stub)$" "$err")" 2
  ck "cleanup: a failed rm of an accepted ID that is still listed is reported with docker's stderr" \
    "$(grep -c "^cleanup: could not remove '$P-rmfail' ($h19): docker rm failed (Error response from daemon: removal refused (stub)); $h19 is still listed$" "$err")" 2
  for n in gone inspectrace rmgone; do
    ck "cleanup: '$n' (a successful empty docker ps) is gone: not reported" "$(grep -c "'$P-$n'" "$err")" 0
  done
  ck "cleanup: unresolved lookups counted (15 names x 2 passes + 1 unregistered)" "$REJECTED" 31
  ck "cleanup: pin carried: 'pinned-swap' still pinned to the gone ID, not to its successor" "${CIDOF[$P-pinned-swap]}" "$h1"
  ck "cleanup: a rejected candidate is never pinned" "${CIDOF[$P-mount]-unset}" unset
  ck "cleanup: stderr has nothing besides those reports" "$(grep -vc '^cleanup: ' "$err")" 0

  # Supervisor, on this subshell's own children only.
  unset -f docker
  SCTL=() SST=() SEXIT=()
  T=10
  spawn sx-exit -- /bin/sh -c 'exit 7' </dev/null
  ck "supervise: started" "$?" 0
  sup_wait sx-exit
  ck "supervise: reports the child's exit code" "$? $WAIT_RC" "0 7"
  spawn sx-in -- /bin/sh -c 'read -r l; echo "$l"' <<<"from-the-caller" >"$BASE/selftest-in"
  sup_wait sx-in
  ck "supervise: the child's stdin is the one redirected on the spawn call" "$WAIT_RC $(<"$BASE/selftest-in")" "0 from-the-caller"
  exec {kf}</dev/null
  spawn sx-fds "$kf" -- /bin/sh -c 'n=0; while [ $n -lt 1024 ]; do [ -e /proc/self/fd/$n ] && printf "%s " $n; n=$((n + 1)); done' \
    </dev/null >"$BASE/selftest-fds" 2>/dev/null
  sup_wait sx-fds
  ck "supervise: the child holds only stdio and the kept fd (no control or status FIFO)" "$(<"$BASE/selftest-fds")" "0 1 2 $kf "
  exec {kf}<&-
  spawn sx-term -- sleep 30 </dev/null
  sup_sig sx-term TERM
  ck "supervise: TERM to its running child is sent through the pidfd" "$?" 0
  sup_wait sx-term
  ck "supervise: that child reports 143" "$WAIT_RC" 143
  spawn sx-kill -- sleep 30 </dev/null
  sup_sig sx-kill KILL
  ck "supervise: KILL to its running child is sent through the pidfd" "$?" 0
  sup_wait sx-kill
  ck "supervise: that child reports 137" "$WAIT_RC" 137
  sup_sig sx-kill KILL
  ck "supervise: nothing is sent once the child's exit was reported" "$?" 1
  spawn sx-ref -- sleep 30 </dev/null
  sup_sig sx-ref INT
  ck "supervise: the suite sends only TERM or KILL" "$?" 1
  printf 'HUP\n' >&"${SCTL[sx-ref]}"
  sup_line sx-ref
  ck "supervise: the supervisor refuses any other request" "$SLINE" "refused HUP"
  sup_end sx-ref
  ck "supervise: releasing the control FIFO SIGKILLs the child and reports it" "$? ${SEXIT[sx-ref]-}" "0 137"
  # Each supervisor drops the descriptors it inherited, so a later supervisor does not
  # keep an earlier one's control FIFO open: releasing the earlier one still reaches it.
  spawn sx-a -- sleep 30 </dev/null
  spawn sx-b -- sleep 30 </dev/null
  sup_end sx-a
  ck "supervise: releasing one supervisor works while a later one still runs" "$? ${SEXIT[sx-a]-}" "0 137"
  sup_end sx-b
  spawn sx-noexec -- "$BASE/no-such-command" </dev/null 2>/dev/null
  ck "supervise: a command that cannot run fails spawn with exit 127" "$? ${SEXIT[sx-noexec]-}" "1 127"
  # Writer check. `spawn` always opens CTL before it starts the supervisor, so these run
  # `supervise` directly, with CTL in a chosen state when the supervisor opens it:
  #   closed           the only writer opened and closed again (the pipe is gone)
  #   closed-buffered  TERM and HUP written, then the only writer closed while this
  #                    shell keeps a read-only fd, so the bytes stay in the pipe
  #   open-buffered    KILL written and the writer kept open (control)
  # The child would create $d/ran, then waits for EOF on $d/hold, a FIFO whose only
  # writer is this shell. "alive" is a FIFO whose only writer is a KEEP_FD of the
  # supervisor, inherited by any child it starts: EOF on it means that both have exited.
  # raw_sup NAME MODE -> RAW (status lines, "started PID" normalised), RAWEND (eof or
  # timeout), RAN (yes or no). Closing $d/hold at the end ends a leaked child (EOF on its
  # stdin), so no failure here needs a signal.
  raw_sup() {
    local d="$BASE/raw-$1" c s r= h ar aw al l
    mkdir "$d" && mkfifo "$d/ctl" "$d/st" "$d/alive" "$d/hold" || return 1
    exec {s}<>"$d/st" {h}<>"$d/hold" {ar}<>"$d/alive"
    exec {aw}>"$d/alive" {al}<"$d/alive"
    exec {ar}<&-
    exec {c}<>"$d/ctl"
    case $2 in
      closed) exec {c}>&- ;;
      closed-buffered) exec {r}<"$d/ctl"; printf 'TERM\nHUP\n' >&"$c"; exec {c}>&- ;;
      open-buffered) printf 'KILL\n' >&"$c" ;;
    esac
    # The supervisor itself closes everything inherited except stdio and "alive" (and
    # so drops the read-only fd $r); the redirections below only make that explicit.
    python3 -I "$HERE/supervise" "$d/ctl" "$d/st" "$aw" -- /bin/sh -c ': >"$1"; exec cat >/dev/null' _ "$d/ran" \
      <"$d/hold" >/dev/null {c}>&- {s}>&- {h}>&- {al}<&- &
    exec {aw}>&-
    RAW= RAWEND=timeout
    while read -r -t "$T" -u "$s" l; do
      [[ $l == started\ * ]] && l="started PID"
      RAW+=${RAW:+ }$l
      [[ $l == exit\ * ]] && break
    done
    read -r -t "$T" -u "$al" l
    (($? == 1)) && RAWEND=eof
    [[ -e $d/ran ]] && RAN=yes || RAN=no
    exec {c}>&- {h}>&- {s}<&- {al}<&-
    [[ -z $r ]] || exec {r}<&-
  }
  raw_sup closed closed
  ck "supervise: CTL writer closed before the supervisor opened it: no child started, exit 125, supervisor gone" \
    "$RAW|$RAWEND|$RAN" "exit 125|eof|no"
  raw_sup buffered closed-buffered
  ck "supervise: requests buffered before that EOF are each answered (no child), then exit 125" \
    "$RAW|$RAWEND|$RAN" "gone TERM refused HUP exit 125|eof|no"
  raw_sup early-kill open-buffered
  ck "supervise: control: a request written before the supervisor opened CTL reaches the child" \
    "$RAW|$RAWEND" "started PID sent KILL exit 137|eof"
  spawn sx-exit -- true </dev/null
  ck "supervise: a key is never reused" "$?" 1
  ck "supervise: no supervisor left open" "${#SCTL[@]} ${#SST[@]}" "0 0"
  ((fails > 100)) && fails=100
  exit "$fails"
)

# =========================================================================================
echo "# 0. cleanup ownership (stubbed docker) and the process supervisor (own children only)"
cleanup_selftest
expect "case 0: every check above held" "$?" 0
if ((SELFTEST_ONLY)); then
  echo
  echo "passed $PASS, failed $FAIL"
  ((FAIL == 0)) || exit 1
  exit 0
fi

echo "# 1. startup never seeds: missing provision"
new_store
before=$(snapshot "$STORE")
run_cmd miss-start start "$STORE" --tenant local --route chat
expect "start on an empty store refuses not_provisioned (exit 3)" "$RC $(jget "$OUT" 'd["reason"]')" "3 not_provisioned"
expect "empty store left empty" "$(snapshot "$STORE")" "$before"
run_cmd miss-start2 start "$STORE" --tenant local --route chat
expect "a second start still refuses and still seeds nothing" "$RC $(snapshot "$STORE")" "3 $before"

echo "# 2. interrupted provision is never promoted, removed or reseeded"
new_store
SRC_STORE=$STORE
run_cmd int-src provision "$SRC_STORE" "${PROV_ARGS[@]}"
expect "control: provision of a fresh store succeeds" "$RC" 0
new_store
# A rev-1 record that was staged and synced but never renamed: exactly the bytes the
# real provision writes, under the staging name only.
cp -- "$SRC_STORE/route.rec" "$STORE/route.rec.tmp" && chmod 600 "$STORE/route.rec.tmp"
before=$(snapshot "$STORE")
run_cmd int-start start "$STORE" --tenant local --route chat
expect "start refuses interrupted_provision (exit 3)" "$RC $(jget "$OUT" 'd["reason"]')" "3 interrupted_provision"
expect "temp untouched, no route.rec created" "$(snapshot "$STORE")" "$before"
run_cmd int-prov provision "$STORE" "${PROV_ARGS[@]}"
expect "provision refuses interrupted_provision (exit 3)" "$RC $(jget "$OUT" 'd["reason"]')" "3 interrupted_provision"
expect "temp still untouched after provision attempt" "$(snapshot "$STORE")" "$before"

echo "# 3. contention on an unprovisioned store: refused before any mutation"
new_store
mkfifo "$BASE/h-ready" "$BASE/h-release"
exec {HR}<>"$BASE/h-ready" {HW}<>"$BASE/h-release"
# A foreign wrapped writer on the host holds the store; the commands' wrapper runs in
# the container and sees the same inode through the bind mount.
spawn holder "$HR" "$HW" -- "$WRAP" "$STORE" -- /bin/bash -c 'echo ready >&"$1"; read -r _ <&"$2"' _ "$HR" "$HW" </dev/null ||
  abort "host holder not started: $WHY"
read -r -t "$T" -u "$HR" hl || { check_sig; hl=timeout; }
expect "host holder acquired the lock" "$hl" ready
before=$(snapshot "$STORE")
run_cmd busy-prov provision "$STORE" "${PROV_ARGS[@]}"
expect "provision while held: busy 75 from the wrapper inside the container" "$RC $(grep -c '^with-route-store-lock: busy' <<<"$ERR")" "75 1"
expect "provision while held: no writer event, nothing written" "${OUT:-none} $(snapshot "$STORE")" "none $before"
run_cmd busy-start start "$STORE" --tenant local --route chat
expect "start while held: busy 75, store unchanged" "$RC $(snapshot "$STORE")" "75 $before"
echo go >&"$HW"
sup_wait holder
expect "host holder exits 0 once released (cooperatively, over its FIFO)" "$WAIT_RC" 0
exec {HR}>&- {HW}>&-
run_cmd busy-after provision "$STORE" "${PROV_ARGS[@]}"
expect "control: provision acquires once the holder exits" "$RC $(jget "$OUT" 'd["record"]["rev"]')" "0 1"

echo "# 4. lifecycle: provision, start, contention, acknowledged change, normal stop"
new_store
LS=$STORE
run_cmd life-prov provision "$LS" "${PROV_ARGS[@]}"
expect "provision exit 0, rev 1, no last_plan_digest" "$RC $(jget "$OUT" 'd["record"]["rev"]') $(jget "$OUT" 'd["record"]["last_plan_digest"]')" "0 1 null"
D1=$(jget "$OUT" 'd["record"]["digest"]')
rec1=$(snapshot "$LS")
run_cmd life-prov2 provision "$LS" "${PROV_ARGS[@]}"
expect "second provision refuses already_provisioned, record unchanged" "$RC $(jget "$OUT" 'd["reason"]') $(snapshot "$LS")" "3 already_provisioned $rec1"

start_writer w1 "$LS"
event
expect "start #1 ready: rev 1, provisioned digest" "$(jget "$LINE" 'd["event"]') $(jget "$LINE" 'd["record"]["rev"]') $(jget "$LINE" 'd["record"]["digest"]')" "ready 1 $D1"
owned_cid "$WNAME" || abort "pin the start #1 container: $WHY"
BP=$(beam_pid "$CID")
expect "writer is beam.smp as the container's PID 1" "$(basename "$(readlink "/proc/$BP/exe" 2>/dev/null)") $(jget "$LINE" 'd["os_pid"]')" "beam.smp 1"
fds=$(fd_on_store "$BP" "$LS")
fd=${fds%% *}
expect "BEAM holds exactly one fd on the store inode" "$(wc -w <<<"$fds")" 1
expect "exclusive flock attached to that fd (kernel fdinfo)" \
  "$(grep -cE "^lock:.*FLOCK +ADVISORY +WRITE .* $(store_key "$LS") " "/proc/$BP/fdinfo/$fd" 2>/dev/null)" 1
expect "no other process holds the store open" "$(holders_of "$LS")" "$BP"

before=$(snapshot "$LS")
run_cmd life-busy-prov provision "$LS" "${PROV_ARGS[@]}"
expect "provision against the running store: busy 75" "$RC $(grep -c '^with-route-store-lock: busy' <<<"$ERR")" "75 1"
run_cmd life-busy-start start "$LS" --tenant local --route chat
expect "second start against the running store: busy 75" "$RC $(grep -c '^with-route-store-lock: busy' <<<"$ERR")" "75 1"
expect "store unchanged by both contenders (before any mutation)" "$(snapshot "$LS")" "$before"

send "apply b"
event
expect "acknowledged change: rev 2, preferred b" "$(jget "$LINE" 'd["event"]') $(jget "$LINE" 'd["record"]["rev"]') $(jget "$LINE" 'd["record"]["preferred"]')" "applied 2 b"
P2=$(jget "$LINE" 'd["plan_digest"]')
D2=$(jget "$LINE" 'd["record"]["digest"]')
expect "ack carries last_plan_digest == plan digest" "$(jget "$LINE" 'd["record"]["last_plan_digest"]')" "$P2"
expect "on disk: route.rec names rev 2 with the acked digests, no temp left" \
  "$(grep -c "\"chat\",2,\[\"a\",\"b\"\],\"b\",true,5000,2,\"$D2\"\],\"$P2\"\]" "$LS/route.rec") $(ls "$LS")" "1 route.rec"
before=$(snapshot "$LS")
run_cmd life-busy-prov2 provision "$LS" "${PROV_ARGS[@]}"
expect "provision after the change: still busy 75, store unchanged" "$RC $(snapshot "$LS")" "75 $before"

client_sig TERM # to the launcher's docker client, which forwards it to the BEAM (--sig-proxy)
event
expect "SIGTERM to the start command: orderly stop event" "$(jget "$LINE" 'd["event"]') $(jget "$LINE" 'd["reason"]')" "stopped sigterm"
writer_wait
expect "start command exit 0 after normal stop" "$WAIT_RC" 0
end_writer
expect "the container is gone (docker ps exits 0 and lists nothing)" \
  "$(if ps_ids "name=^${WNAME}\$"; then echo "${IDS:-none}"; else echo "lookup failed: $WHY"; fi)" none
expect "nothing holds the store any more" "$(holders_of "$LS")" ""
expect "normal stop left the record as acknowledged" "$(snapshot "$LS")" "$before"

echo "# 5. restart after normal stop: same revision and plan digest; then abrupt BEAM exit"
start_writer w2 "$LS"
event
expect "start #2 ready: rev 2, acked digest, acked plan digest" \
  "$(jget "$LINE" 'd["event"]') $(jget "$LINE" 'd["record"]["rev"]') $(jget "$LINE" 'd["record"]["digest"]') $(jget "$LINE" 'd["record"]["last_plan_digest"]')" \
  "ready 2 $D2 $P2"
expect "restart did not rewrite the record" "$(snapshot "$LS")" "$before"
send "apply a"
event
expect "acknowledged change: rev 3, preferred a" "$(jget "$LINE" 'd["event"]') $(jget "$LINE" 'd["record"]["rev"]') $(jget "$LINE" 'd["record"]["preferred"]')" "applied 3 a"
P3=$(jget "$LINE" 'd["plan_digest"]')
D3=$(jget "$LINE" 'd["record"]["digest"]')
after3=$(snapshot "$LS")
# Abrupt exit: SIGKILL the BEAM through docker, addressed by the full ID of this run's
# container, never by host PID. Any failed check aborts the run before the kill.
verify_writer "$WNAME" "$LS" start || abort "verify the writer before docker kill: $WHY"
ok "writer verified: container ${CID:0:12}… runs beam.smp (host pid $VPID, ns pid 1) holding the store lock"
still_same || abort "writer changed before docker kill: $WHY"
expect "docker kill --signal KILL of exactly that container (full ID)" \
  "$(timeout -k 5 "$T" docker kill --signal KILL "$CID" 2>&1)" "$CID"
writer_wait
expect "start command reports the BEAM killed (137)" "$WAIT_RC" 137
end_writer
expect "nothing holds the store after SIGKILL" "$(holders_of "$LS")" ""
expect "SIGKILL left the acknowledged record in place" "$(snapshot "$LS")" "$after3"

start_writer w3 "$LS"
event
expect "start #3 after SIGKILL ready: rev 3, acked digest, acked plan digest" \
  "$(jget "$LINE" 'd["event"]') $(jget "$LINE" 'd["record"]["rev"]') $(jget "$LINE" 'd["record"]["digest"]') $(jget "$LINE" 'd["record"]["last_plan_digest"]')" \
  "ready 3 $D3 $P3"
send "read"
event
expect "read back through the store: rev 3, plan digest $P3" "$(jget "$LINE" 'd["record"]["rev"]') $(jget "$LINE" 'd["record"]["last_plan_digest"]')" "3 $P3"
send "stop"
event
expect "harness stop: orderly stop" "$(jget "$LINE" 'd["event"]') $(jget "$LINE" 'd["reason"]')" "stopped harness"
writer_wait
expect "exit 0" "$WAIT_RC" 0
end_writer
expect "record unchanged by restart and stop" "$(snapshot "$LS")" "$after3"

echo "# 6. lock lifetime when the docker client (not the BEAM) is SIGKILLed"
# 6a. Product form (no stdin): the container outlives its client and keeps the lock.
start_writer w4 "$LS" plain
event
expect "plain start ready at rev 3" "$(jget "$LINE" 'd["event"]') $(jget "$LINE" 'd["record"]["rev"]')" "ready 3"
verify_writer "$WNAME" "$LS" start || abort "verify the plain writer before killing its client: $WHY"
BP=$VPID C4=$CID # read only; C4 is pinned to the name from here on
client_sig KILL # the docker client this run started, not the BEAM
writer_wait
end_writer
expect "client dead; the container still runs and its BEAM still holds the store" \
  "$(docker inspect -f '{{.State.Running}}' "$C4" 2>/dev/null) $(holders_of "$LS")" "true $BP"
before=$(snapshot "$LS")
run_cmd orphan-busy start "$LS" --tenant local --route chat
expect "a new start is refused busy (75) while the orphaned writer holds the lock" "$RC" 75
run_cmd orphan-busy-prov provision "$LS" "${PROV_ARGS[@]}"
expect "so is provision (75); store unchanged" "$RC $(snapshot "$LS")" "75 $before"
verify_writer "$WNAME" "$LS" start || abort "verify the orphaned writer before docker stop: $WHY"
[[ $VPID == "$BP" && $CID == "$C4" ]] || abort "orphaned writer $CID/pid $VPID is not the one verified at ready ($C4/$BP)"
still_same || abort "orphaned writer changed before docker stop: $WHY"
expect "recovery: docker stop of exactly that container by full ID returns" \
  "$(timeout -k 5 "$T" docker stop -t 30 "$CID" 2>&1)" "$CID"
# No client is attached any more, so whether that stop was orderly (`stopped` event,
# exit 0) is not observed; what is observed is that the lock is released and the store
# reopens unchanged.
# 6b. Harness form: losing the harness closes the writer's stdin.
start_writer w5 "$LS"
event
expect "after docker stop: the lock is released and start reopens rev 3 / $P3" \
  "$(jget "$LINE" 'd["event"]') $(jget "$LINE" 'd["record"]["rev"]') $(jget "$LINE" 'd["record"]["last_plan_digest"]')" "ready 3 $P3"
verify_writer "$WNAME" "$LS" start || abort "verify the harness writer before killing its client: $WHY"
client_sig KILL # the docker client this run started, not the BEAM
writer_wait
end_writer
# `docker wait` prints the exit code if it saw the exit. If it fails, the container
# counts as exited only if a lookup by full ID exits 0 and lists nothing (--rm removal
# already happened, which says nothing about how the writer exited). Any other failure
# is shown as is.
if w=$(timeout -k 5 "$T" docker wait "$CID" 2>&1); then
  [[ $w == 0 ]] && w=exited
elif gone_by_id "$CID"; then
  w=exited
else
  w="docker wait failed ($w); $WHY"
fi
expect "harness client SIGKILLed: the container exits by itself (exit 0 seen, or already removed)" "$w" exited
expect "nothing holds the store; record still rev 3" "$(holders_of "$LS") $(snapshot "$LS")" " $before"
start_writer w6 "$LS"
event
expect "after the harness-form exit: start reopens rev 3 / $P3" \
  "$(jget "$LINE" 'd["event"]') $(jget "$LINE" 'd["record"]["rev"]') $(jget "$LINE" 'd["record"]["last_plan_digest"]')" "ready 3 $P3"
send "stop"
event
ev=$(jget "$LINE" 'd["event"]')
writer_wait
expect "harness stop: stopped event, exit 0, record unchanged" "$ev $WAIT_RC $(snapshot "$LS")" "stopped 0 $before"
end_writer

echo "# 7. the writer refuses to touch a store it has not locked"
new_store
cp -- "$LS/route.rec" "$STORE/route.rec.tmp" && chmod 600 "$STORE/route.rec.tmp"
before=$(snapshot "$STORE")
cname nolock test "$STORE"
n=$CNAME
out=$(timeout -k 5 "$T" docker run --rm --name "$n" --label telelem.route-store=test --network none --read-only \
  --cap-drop ALL --security-opt no-new-privileges --user "$(id -u):$(id -g)" \
  --tmpfs /tmp:rw,nosuid,nodev,size=64m,mode=1777 -e HOME=/tmp -e ERL_INETRC=/opt/route-store/inetrc \
  -v "$ROOT/lib/telelem:/opt/telelem/lib:ro" -v "$RS:/opt/route-store:ro" -v "$STORE:/sbx/store" \
  "$IMAGE" /bin/sh -ec 'mkdir /tmp/e && cd /tmp/e &&
    elixirc /opt/telelem/lib/ops/boundary.ex /opt/telelem/lib/ops/plan_digest.ex \
      /opt/telelem/lib/ops/file_store.ex /opt/telelem/lib/route/revision.ex \
      /opt/telelem/lib/sandbox/path_policy.ex >&2 && cd / &&
    exec elixir -pa /tmp/e /opt/route-store/main.exs start --dir /sbx/store --tenant local --route chat' 2>&1)
rc=$?
expect "main.exs without the wrapper's lock exits 4" "$rc $(grep -c 'does not hold the store lock' <<<"$out")" "4 1"
expect "store untouched (interrupted temp not removed or promoted)" "$(snapshot "$STORE")" "$before"

echo
echo "passed $PASS, failed $FAIL"
((FAIL == 0)) || exit 1
exit 0
